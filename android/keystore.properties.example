# Copy to android/keystore.properties (gitignored) and fill in real values.
# Generate a keystore once and back it up securely — losing it blocks Play updates.
#
# Example generation (run from android/):
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore upload-keystore.jks -alias wellnessshift-upload \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=upload-keystore.jks
storePassword=REPLACE_ME
keyAlias=wellnessshift-upload
keyPassword=REPLACE_ME

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

  <!-- ── App Identity ──────────────────────────────────────────────────── -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en-GB</string>
  <key>CFBundleDisplayName</key>
  <string>Wellness Shift</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>1.0</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleVersion</key>
  <string>1</string>

  <!-- ── Minimum iOS version ───────────────────────────────────────────── -->
  <key>LSMinimumSystemVersion</key>
  <string>17.0</string>
  <key>MinimumOSVersion</key>
  <string>17.0</string>

  <!-- ── Orientation ───────────────────────────────────────────────────── -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <!-- ── Status bar ────────────────────────────────────────────────────── -->
  <key>UIStatusBarStyle</key>
  <string>UIStatusBarStyleDefault</string>
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>

  <!-- ── App Transport Security ────────────────────────────────────────── -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <false/>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>wellnessshift.co.uk</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
      <key>unsplash.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
      <key>googleapis.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
      <key>firebaseio.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
      <key>firebaseapp.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
      <key>sketchfab.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
      <key>contentsquare.com</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
      <key>contentsquare.net</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
      </dict>
    </dict>
  </dict>

  <!-- ── HealthKit ─────────────────────────────────────────────────────── -->
  <key>NSHealthShareUsageDescription</key>
  <string>Wellness Shift reads your health data — steps, heart rate, sleep and more — to personalise your wellness score and daily plan. We never write to Apple Health.</string>
  <key>NSHealthUpdateUsageDescription</key>
  <string>Wellness Shift does not write data to Apple Health.</string>

  <!-- ── Notifications ─────────────────────────────────────────────────── -->
  <key>UIBackgroundModes</key>
  <array>
    <string>fetch</string>
    <string>remote-notification</string>
  </array>

  <!-- ── React Native internals ────────────────────────────────────────── -->
  <key>UIFileSharingEnabled</key>
  <false/>
  <key>UIRequiresFullScreen</key>
  <false/>
  <key>UILaunchStoryboardName</key>
  <string>LaunchScreen</string>
  <key>UIMainStoryboardFile</key>
  <string></string>

  <!-- ── URL Schemes (Google Sign In) ─────────────────────────────────── -->
  <!-- Replace REVERSED_CLIENT_ID with value from GoogleService-Info.plist -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleURLName</key>
      <string>Google Sign In</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <!-- PASTE YOUR REVERSED_CLIENT_ID FROM GoogleService-Info.plist HERE -->
        <string>com.googleusercontent.apps.912633076119-7r2856eet5vtupfeehfru1k0hrbvgg2m</string>
      </array>
    </dict>
  </array>

  <!-- ── ITSAppUsesNonExemptEncryption ─────────────────────────────────── -->
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>

</dict>
</plist>

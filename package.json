    "@tsconfig/react-native": "^3.0.0",
    "@types/react": "^19.1.1",
    "@types/react-native": "^0.73.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "name": "WellnessShift",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "adb reverse tcp:8081 tcp:8081 2>/dev/null || true && react-native run-android && bash scripts/dismiss-android-compat-dialog.sh",
    "ios": "react-native run-ios",
    "start": "react-native start --host 0.0.0.0",
    "test": "jest",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "functions:build": "npm run build --prefix functions",
    "functions:deploy": "firebase deploy --only functions",
    "deploy:backend": "firebase deploy --only firestore,functions",
    "deploy:rules": "firebase deploy --only firestore:rules --project wellnessshift-rn-ios",
    "deploy:hosting": "firebase deploy --only hosting --project wellnessshift-rn-ios",
    "generate:icons": "python3 scripts/generate-app-icons.py"
  },
  "dependencies": {
    "@contentsquare/react-native-bridge": "^6.4.0",
    "@invertase/react-native-apple-authentication": "^2.4.0",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-firebase/analytics": "^25.1.0",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/app-check": "^25.1.0",
    "@react-native-firebase/auth": "^25.1.0",
    "@react-native-firebase/crashlytics": "^25.1.0",
    "@react-native-firebase/firestore": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-native-firebase/remote-config": "^25.1.0",
    "@react-native-google-signin/google-signin": "^11.0.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@react-navigation/stack": "^6.3.29",
    "@types/three": "^0.185.0",
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "expo": "^57.0.0",
    "expo-gl": "^57.0.1",
    "expo-sensors": "^57.0.1",
    "react": "19.2.3",
    "react-native": "^0.86.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-gifted-charts": "^1.4.20",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^3.5.3",
    "react-native-iap": "^15.3.4",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "^2.12.2",
    "react-native-modal": "^13.0.1",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-permissions": "^4.1.5",
    "react-native-print": "^0.11.0",
    "react-native-qrcode-svg": "^6.3.1",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.15.5",
    "react-native-vector-icons": "^10.1.0",
    "react-native-video": "^6.3.3",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "^0.10.1",
    "three": "^0.185.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-class-static-block": "^8.0.1",
